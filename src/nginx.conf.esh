worker_processes 1;
error_log /dev/stderr warn;
env SERVERS;
env FETCH_TIMEOUT_MS;
env VERIFY_UPSTREAM_TLS;
events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    resolver local=on valid=5s ipv6=off;

    # lua cosocket TLS-верификация не использует системный бандл сама —
    # без этой директивы VERIFY_UPSTREAM_TLS=on падает с "unable to get
    # local issuer certificate" на валидных сертификатах
    lua_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    lua_ssl_verify_depth 3;

    server {
        # Включение или отключение TLS
        <% if [ "$TLS_MODE" != "off" ]; then -%>
        listen <%= $SITE_PORT %> ssl;
        ssl_certificate /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        <% else -%>
        listen <%= $SITE_PORT %>;
        <% fi; -%>

        server_name <%= $SITE_HOST %>;

        # Обработка запросов с фиксированной частью пути и переменным sub_id
        location ~ ^/<%= $SUB %>/([^/]+)/?$ {
            # Извлекаем sub_id из URL
            set $sub_id $1;

            content_by_lua_file /etc/nginx/lua/config_fetcher.lua;
        }

        # Живой эндпоинт для HEALTHCHECK и мониторинга
        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        # Заглушка для других запросов
        location / {
            return 404;
        }
    }
}
